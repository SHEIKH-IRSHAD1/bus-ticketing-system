# Copy to infra/.env and fill in. docker compose reads this automatically.
# Stripe TEST-mode keys only (dashboard.stripe.com/test/apikeys) - free, no business verification.
STRIPE_SECRET_KEY=
# Printed by `stripe listen` when you forward webhooks to your machine (see README).
STRIPE_WEBHOOK_SECRET=
# Any long random string; signs the QR tickets. Generate one: openssl rand -hex 32
TICKET_HMAC_SECRET=
GATEWAY_JWT_SECRET=
